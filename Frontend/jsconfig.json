{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "preserve"
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "*.js",
    "*.jsx",
    "*.mjs"
  ],
  "exclude": ["node_modules", ".next"]
}
